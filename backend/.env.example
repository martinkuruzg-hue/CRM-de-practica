# Copia este archivo como .env y ajusta los valores.
# NUNCA subas .env al repositorio.

# Django
DJANGO_SECRET_KEY=change-me-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Asistente de IA (opcional: sin API key el sistema usa un fallback sin IA externa)
OPENAI_API_KEY=

# Modelo usado por el asistente
OPENAI_MODEL=gpt-4o-mini
